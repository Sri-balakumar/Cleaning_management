<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The root menu carries an action of its own on purpose. Without one,
        Odoo promotes whichever child happens to be visible first, so the page
        people land on would change depending on their role.
    -->
    <menuitem id="menu_cleaning_root"
              name="Showroom Check"
              web_icon="showroom_check,static/description/icon.png"
              action="showroom_check.action_cleaning_dashboard"
              groups="showroom_check.group_cleaning_user"
              sequence="85"/>

    <menuitem id="menu_cleaning_dashboard"
              name="Check"
              parent="menu_cleaning_root"
              action="showroom_check.action_cleaning_dashboard"
              groups="showroom_check.group_cleaning_user"
              sequence="5"/>

    <menuitem id="menu_cleaning_recordings"
              name="History"
              parent="menu_cleaning_root"
              action="showroom_check.action_cleaning_recording"
              groups="showroom_check.group_cleaning_user"
              sequence="10"/>

    <!-- No groups= on the section headings. Each child carries its own, and
         Odoo already hides a heading whose children are all hidden. Putting a
         group on the heading is how a whole section disappears for somebody
         who should see part of it. -->
    <menuitem id="menu_cleaning_reporting"
              name="Reporting"
              parent="menu_cleaning_root"
              sequence="20"/>

    <!-- Before Missed Rounds: "did the room match" is the question asked
         daily, and "was anything skipped" the one asked weekly. -->
    <menuitem id="menu_cleaning_comparisons"
              name="Comparisons"
              parent="menu_cleaning_reporting"
              action="showroom_check.action_cleaning_comparison"
              groups="showroom_check.group_cleaning_user"
              sequence="5"/>

    <menuitem id="menu_cleaning_missed"
              name="Missed Rounds"
              parent="menu_cleaning_reporting"
              action="showroom_check.action_cleaning_slot_missed"
              groups="showroom_check.group_cleaning_manager"
              sequence="10"/>

    <menuitem id="menu_cleaning_configuration"
              name="Configuration"
              parent="menu_cleaning_root"
              sequence="30"/>

    <menuitem id="menu_cleaning_settings"
              name="Settings"
              parent="menu_cleaning_configuration"
              action="showroom_check.action_cleaning_config_open"
              groups="showroom_check.group_cleaning_manager"
              sequence="10"/>

    <menuitem id="menu_cleaning_ai"
              name="AI Review"
              parent="menu_cleaning_configuration"
              action="showroom_check.action_cleaning_ai_config_open"
              groups="showroom_check.group_cleaning_manager"
              sequence="30"/>

    <menuitem id="menu_cleaning_slots"
              name="Rounds"
              parent="menu_cleaning_configuration"
              action="showroom_check.action_cleaning_slot"
              groups="showroom_check.group_cleaning_manager"
              sequence="20"/>

</odoo>
