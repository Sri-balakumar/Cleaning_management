<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cleaning_recording_list" model="ir.ui.view">
        <field name="name">cleaning.recording.list</field>
        <field name="model">cleaning.recording</field>
        <field name="arch" type="xml">
            <list string="Recordings" create="false">
                <field name="slot_date"/>
                <field name="slot_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="started_at"/>
                <!-- Hidden by default now that a round need not be a clip: on a
                     photographs-only office every one of these is blank, and a
                     list of blanks looks like a list of failures. They are one
                     click away in the optional-columns menu for anybody who
                     does record video. -->
                <field name="duration_seconds" optional="hide"/>
                <field name="file_format" optional="hide"/>
                <field name="quality" optional="hide"/>
                <field name="file_size_mb" sum="Total (MB)" optional="hide"/>
                <!-- What a round is actually judged on. -->
                <field name="shot_count" optional="show"/>
                <field name="match_score" optional="show" widget="progressbar"/>
                <field name="match_level" optional="show" widget="badge"
                       decoration-danger="match_level == 'alert'"
                       decoration-warning="match_level == 'warn'"
                       decoration-success="match_level == 'ok'"/>
                <field name="ai_status" optional="show"/>
                <field name="ai_score" optional="hide" widget="progressbar"/>
                <field name="truncated" optional="hide"/>
                <field name="capture_mode" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cleaning_recording_form" model="ir.ui.view">
        <field name="name">cleaning.recording.form</field>
        <field name="model">cleaning.recording</field>
        <field name="arch" type="xml">
            <form string="Recording" create="false">
                <header>
                    <button name="action_play" type="object" string="Play"
                            class="btn-primary" icon="fa-play"
                            invisible="not video_file"/>
                    <!-- Both counts, not just the stills: a photographs-only
                         round has no stills at all and would otherwise never
                         offer the button. -->
                    <button name="action_ai_analyse" type="object"
                            string="Analyse with AI" icon="fa-magic"
                            groups="showroom_check.group_cleaning_manager"
                            invisible="frame_count == 0 and shot_count == 0"
                            confirm="Send the pictures from this round for AI review?"/>
                    <button name="action_recompute_match" type="object"
                            string="Compare again" icon="fa-refresh"
                            groups="showroom_check.group_cleaning_manager"
                            invisible="shot_count == 0"/>
                    <field name="ai_status" widget="statusbar"
                           statusbar_visible="not_run,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Something Has Changed"
                            bg_color="text-bg-danger"
                            invisible="match_level != 'alert'"/>
                    <widget name="web_ribbon" title="Worth A Look"
                            bg_color="text-bg-warning"
                            invisible="match_level != 'warn'"/>
                    <widget name="web_ribbon" title="Cut Short" bg_color="text-bg-warning"
                            invisible="not truncated or match_level in ['alert', 'warn']"/>
                    <field name="match_level" invisible="1"/>
                    <field name="shot_count" invisible="1"/>
                    <!-- Up here rather than beside the file fields, because it
                         is what decides whether those fields are shown at all -
                         and a modifier cannot depend on a field that is only
                         present inside the block it is hiding. The filename
                         rather than video_file itself: testing the binary would
                         have the form load the whole video to find out whether
                         there is one. -->
                    <field name="video_filename" invisible="1"/>
                    <!-- Technical: drives the read-only state below. -->
                    <field name="can_manage" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="slot_id" readonly="1" options="{'no_open': True}"/></h1>
                        <h3><field name="slot_date" readonly="1"/></h3>
                    </div>

                    <!-- The point of opening a recording is to watch it, so the
                         player goes first. The binary field further down is kept
                         for downloading a copy.

                         Unless there is nothing to watch. With the video
                         switched off a round is the photographs and nothing
                         else, and an empty player above a File section full of
                         blanks reads as a recording that failed rather than as
                         one that was never meant to exist. -->
                    <widget name="cleaning_video_player"
                            invisible="not video_filename"/>
                    <div class="alert alert-info" role="alert"
                         invisible="video_filename">
                        <strong>Photographs only.</strong>
                        The video is switched off for this office, so this round
                        is its photographs. They are below, each beside the
                        original it was compared against.
                    </div>
                    <group>
                        <group string="Recording">
                            <field name="user_id" readonly="1" widget="many2one_avatar_user"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <!-- Every one of these describes a clip. With none
                                 recorded they are zeroes that mean nothing, and
                                 a zero is read as a measurement. -->
                            <field name="duration_seconds"
                                   invisible="not video_filename"/>
                            <field name="configured_duration_seconds"
                                   invisible="not video_filename"/>
                            <field name="truncated"
                                   invisible="not video_filename"/>
                        </group>
                        <group string="File" invisible="not video_filename">
                            <field name="video_file" filename="video_filename"
                                   readonly="1"/>
                            <field name="file_format"/>
                            <field name="quality"/>
                            <field name="mimetype"/>
                            <field name="file_size_mb"/>
                            <field name="width"/>
                            <field name="height"/>
                        </group>
                        <group string="Photographs" invisible="video_filename">
                            <field name="shot_size" string="Photograph Bytes"
                                   invisible="1"/>
                            <field name="match_score"/>
                            <field name="match_score_avg"/>
                            <field name="match_worst_label"/>
                            <field name="matched_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Showroom Photos" name="shots"
                              invisible="shot_count == 0">
                            <group>
                                <group>
                                    <field name="match_score"/>
                                    <field name="match_worst_label"/>
                                </group>
                                <group>
                                    <field name="match_score_avg"/>
                                    <field name="matched_at"/>
                                </group>
                            </group>

                            <!-- Both pictures on one card, addressed by URL.
                                 NOT kanban_image(): that helper no longer exists
                                 in this version and the card threw
                                 "kanban_image is not a function", taking the
                                 whole form down with it. /web/image is the
                                 documented way and is access-checked per record
                                 by ir.binary, so
                                 no custom component is needed to show them side
                                 by side. -->
                            <field name="shot_ids" nolabel="1" readonly="1">
                                <kanban class="o_kanban_mobile" create="false">
                                    <field name="reference_image_id"/>
                                    <field name="match_level"/>
                                    <field name="match_error"/>
                                    <field name="reference_replaced"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="row g-0">
                                                <div class="col-12 mb-1">
                                                    <strong><field name="name"/></strong>
                                                    <span class="float-end">
                                                        <field name="match_level"
                                                               widget="badge"
                                                               decoration-danger="match_level == 'alert'"
                                                               decoration-warning="match_level == 'warn'"
                                                               decoration-success="match_level == 'ok'"/>
                                                    </span>
                                                </div>
                                                <div class="col-6 pe-1">
                                                    <div class="text-muted small">Original</div>
                                                    <img t-att-src="'/web/image/cleaning.reference.image/' + record.reference_image_id.raw_value + '/image'"
                                                         class="img img-fluid" alt="Original"/>
                                                </div>
                                                <div class="col-6 ps-1">
                                                    <div class="text-muted small">Today</div>
                                                    <img t-att-src="'/web/image/cleaning.recording.shot/' + record.id.raw_value + '/image'"
                                                         class="img img-fluid" alt="Today"/>
                                                </div>
                                                <div class="col-12 mt-1">
                                                    <span>Match <field name="match_score"/>%</span>
                                                    <div class="text-muted">
                                                        <field name="ai_changes"/>
                                                    </div>
                                                    <div class="text-danger small"
                                                         t-if="record.match_error.raw_value">
                                                        <field name="match_error"/>
                                                    </div>
                                                    <div class="text-warning small"
                                                         t-if="record.reference_replaced.raw_value">
                                                        The original for this view has been
                                                        replaced since this round was recorded.
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" readonly="not can_manage"
                                   placeholder="Anything worth noting about this round."/>
                        </page>
                        <page string="AI Review" name="ai_review"
                              groups="showroom_check.group_cleaning_manager"
                              invisible="ai_status == 'not_run' and frame_count == 0">
                            <div class="alert alert-secondary" role="alert">
                                <i class="fa fa-info-circle me-1"/>
                                A second opinion from an AI, not a verdict. It can be
                                wrong - check the video before acting on it.
                            </div>
                            <group invisible="ai_status != 'done'">
                                <group>
                                    <field name="ai_score" widget="progressbar"/>
                                    <field name="ai_checked_at"/>
                                    <field name="ai_model_used"/>
                                </group>
                                <group>
                                    <field name="frame_count"/>
                                </group>
                            </group>
                            <group string="Summary" invisible="ai_status != 'done'">
                                <field name="ai_summary" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Problems Spotted"
                                   invisible="ai_status != 'done' or not ai_issues">
                                <field name="ai_issues" nolabel="1" readonly="1"/>
                            </group>
                            <field name="ai_result_ids" readonly="1"
                                   invisible="ai_status != 'done'">
                                <list>
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="passed" widget="badge"
                                           decoration-success="passed == 'yes'"
                                           decoration-danger="passed == 'no'"
                                           decoration-warning="passed == 'unclear'"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <div class="alert alert-danger" role="alert"
                                 invisible="ai_status != 'failed'">
                                <strong>The review did not complete.</strong>
                                <field name="ai_error" nolabel="1" readonly="1"/>
                            </div>
                            <div class="text-muted"
                                 invisible="ai_status != 'not_run'">
                                Not reviewed yet. Press <strong>Analyse with AI</strong>
                                above.
                            </div>
                            <!-- Manager-only via the field's own groups, NOT
                                 base.group_no_one: Odoo caches the view layout in
                                 the browser with a key that ignores debug mode, so
                                 an arch that changes with dev mode renders
                                 inconsistently for the same person. -->
                            <group string="Raw Reply"
                                   invisible="not ai_raw_response">
                                <field name="ai_raw_response" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                        <page string="Audit" name="audit"
                              groups="showroom_check.group_cleaning_manager">
                            <group>
                                <group>
                                    <field name="capture_mode"/>
                                    <field name="uploaded_at"/>
                                    <field name="ip_address"/>
                                    <field name="browser"/>
                                </group>
                                <group>
                                    <field name="location"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="user_agent"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cleaning_recording_search" model="ir.ui.view">
        <field name="name">cleaning.recording.search</field>
        <field name="model">cleaning.recording</field>
        <field name="arch" type="xml">
            <search string="Recordings">
                <field name="slot_id"/>
                <field name="user_id"/>
                <field name="slot_date"/>
                <filter name="filter_today" string="Today"
                        domain="[('slot_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('slot_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_mine" string="My Recordings"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <!-- '=' and '!=' against False are the only tests that work on a
                     stored file field, so this filter cannot be written any
                     other way. -->
                <filter name="filter_no_video" string="Video Removed"
                        domain="[('video_file', '=', False)]"/>
                <filter name="filter_truncated" string="Cut Short"
                        domain="[('truncated', '=', True)]"/>
                <group>
                    <filter name="group_date" string="Date" context="{'group_by': 'slot_date'}"/>
                    <filter name="group_slot" string="Round" context="{'group_by': 'slot_id'}"/>
                    <filter name="group_user" string="Recorded By" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cleaning_recording_calendar" model="ir.ui.view">
        <field name="name">cleaning.recording.calendar</field>
        <field name="model">cleaning.recording</field>
        <field name="arch" type="xml">
            <calendar string="Recordings" date_start="started_at" color="slot_id"
                      mode="month" quick_create="false">
                <field name="slot_id"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_cleaning_recording" model="ir.actions.act_window">
        <field name="name">Recordings</field>
        <field name="res_model">cleaning.recording</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No recordings yet</p>
            <p>
                Recordings appear here once somebody presses Record on the
                dashboard during an open round.
            </p>
        </field>
    </record>

</odoo>
