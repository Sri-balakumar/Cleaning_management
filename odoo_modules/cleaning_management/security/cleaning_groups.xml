<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- The app heading users see in Settings -> Users. -->
        <record id="module_category_cleaning_management" model="ir.module.category">
            <field name="name">Cleaning Management</field>
            <field name="description">Scheduled camera check-in for office cleaning rounds.</field>
            <field name="sequence">85</field>
        </record>

        <!--
            In Odoo 19 a group no longer carries the category itself; it hangs
            off a privilege, and the privilege carries the category.

            The privilege supplies the LABEL on the user form and the groups
            supply the OPTIONS, so the form reads:

                Cleaning Management:  [ No access | User | Manager ]

            That is exactly why the two groups below are named plainly "User"
            and "Manager" - calling them "Cleaning User" would render as
            "Cleaning Management: Cleaning User".
        -->
        <record id="privilege_cleaning_management" model="res.groups.privilege">
            <field name="name">Cleaning Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_cleaning_management"/>
            <field name="placeholder">No access</field>
            <field name="description">Who can record cleaning rounds, and who can configure them.</field>
        </record>

        <record id="group_cleaning_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_cleaning_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Opens the Cleaning dashboard and records a round while its window is open. Sees only their own recordings, and cannot change or delete any of them.</field>
        </record>

        <record id="group_cleaning_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_cleaning_management"/>
            <field name="implied_ids" eval="[(4, ref('cleaning_management.group_cleaning_user'))]"/>
            <field name="comment">Sets up the rounds, times, recording quality, who is allowed to record, and how long recordings are kept. Sees every recording and can delete them; deleting one re-opens that round for the day.</field>
        </record>

        <!-- Administrators get Manager automatically, so the app is usable
             immediately after installing without hand-assigning anyone. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('cleaning_management.group_cleaning_manager'))]"/>
        </record>

    </data>
</odoo>
