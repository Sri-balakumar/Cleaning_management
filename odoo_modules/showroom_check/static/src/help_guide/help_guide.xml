<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="showroom_check.HelpGuideDialog">
        <Dialog title="props.title or 'Help'" size="'lg'">
            <div class="d-flex flex-column gap-2">
                <t t-if="state.loaded and !state.docs.length">
                    <p class="text-muted text-center p-4">
                        Nothing here yet.
                    </p>
                </t>

                <t t-foreach="state.docs" t-as="doc" t-key="doc.id">
                    <div class="border rounded p-3" style="background:#F8FAFC;">
                        <div class="mb-1" style="font-size:15px;">
                            <span t-esc="doc.icon" class="me-1"/>
                            <b t-esc="doc.name"/>
                            <!-- Only a manager ever sees a mixed shelf, so this
                                 only ever appears for them - the same caption
                                 the phone puts on the same rows. A card with no
                                 chip is one nothing is held back from. -->
                            <span t-if="doc.audience === 'manager'"
                                  class="badge text-bg-secondary ms-2"
                                  style="font-weight:500;">Managers only</span>
                        </div>
                        <div t-if="doc.description" class="text-muted mb-2" style="font-size:13px;"
                             t-esc="doc.description"/>
                        <!-- The label names what opens, so nobody is surprised
                             by a PDF appearing where a page was promised. -->
                        <button class="btn btn-primary btn-sm"
                                t-on-click="() => this.openDoc(doc)">
                            <t t-if="opensPdf(doc)">📄 Open PDF</t>
                            <t t-else="">📖 Open guide</t>
                        </button>
                    </div>
                </t>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
