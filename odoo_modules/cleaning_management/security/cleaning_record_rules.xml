<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Company scoping. Global rules apply to everyone, managers included. -->
        <record id="rule_cleaning_config_company" model="ir.rule">
            <field name="name">Cleaning configuration: own company</field>
            <field name="model_id" ref="model_cleaning_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_slot_company" model="ir.rule">
            <field name="name">Cleaning round: own company</field>
            <field name="model_id" ref="model_cleaning_slot"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_recording_company" model="ir.rule">
            <field name="name">Cleaning recording: own company</field>
            <field name="model_id" ref="model_cleaning_recording"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_slot_missed_company" model="ir.rule">
            <field name="name">Missed cleaning round: own company</field>
            <field name="model_id" ref="model_cleaning_slot_missed"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- A User sees their own recordings only. -->
        <record id="rule_cleaning_recording_user_own" model="ir.rule">
            <field name="name">Cleaning recording: own recordings only</field>
            <field name="model_id" ref="model_cleaning_recording"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cleaning_management.group_cleaning_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            A Manager sees everything.

            This record is NOT optional. Manager implies User, so a Manager also
            holds the User group above and would otherwise be quietly narrowed
            to their own recordings - which looks exactly like the module being
            broken. Rules like these are combined with OR across the groups
            somebody holds, so this widens the rule above rather than fighting
            with it.
        -->
        <record id="rule_cleaning_recording_manager_all" model="ir.rule">
            <field name="name">Cleaning recording: manager sees all</field>
            <field name="model_id" ref="model_cleaning_recording"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cleaning_management.group_cleaning_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
