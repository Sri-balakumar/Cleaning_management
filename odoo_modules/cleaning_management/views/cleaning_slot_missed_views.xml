<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cleaning_slot_missed_list" model="ir.ui.view">
        <field name="name">cleaning.slot.missed.list</field>
        <field name="model">cleaning.slot.missed</field>
        <field name="arch" type="xml">
            <list string="Missed Rounds" create="false" delete="false">
                <field name="slot_date"/>
                <field name="slot_id"/>
                <field name="day_period"/>
                <field name="hour_from" widget="float_time"/>
                <field name="hour_to" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cleaning_slot_missed_search" model="ir.ui.view">
        <field name="name">cleaning.slot.missed.search</field>
        <field name="model">cleaning.slot.missed</field>
        <field name="arch" type="xml">
            <search string="Missed Rounds">
                <field name="slot_id"/>
                <field name="slot_date"/>
                <filter name="filter_last_week" string="Last 7 Days"
                        domain="[('slot_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_last_month" string="Last 30 Days"
                        domain="[('slot_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_date" string="Date" context="{'group_by': 'slot_date'}"/>
                    <filter name="group_slot" string="Round" context="{'group_by': 'slot_id'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'day_period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_cleaning_slot_missed_graph" model="ir.ui.view">
        <field name="name">cleaning.slot.missed.graph</field>
        <field name="model">cleaning.slot.missed</field>
        <field name="arch" type="xml">
            <graph string="Missed Rounds" type="bar" sample="1">
                <field name="slot_date" interval="day"/>
                <field name="slot_id"/>
            </graph>
        </field>
    </record>

    <record id="action_cleaning_slot_missed" model="ir.actions.act_window">
        <field name="name">Missed Rounds</field>
        <field name="res_model">cleaning.slot.missed</field>
        <field name="view_mode">list,graph</field>
        <field name="context">{'search_default_filter_last_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing was missed</p>
            <p>
                Every round scheduled in the last 30 days was recorded.
                Today is not included here - it is still in progress, and
                shows on the dashboard instead.
            </p>
        </field>
    </record>

</odoo>
