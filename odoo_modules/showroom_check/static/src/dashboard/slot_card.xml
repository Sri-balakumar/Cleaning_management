<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="showroom_check.SlotCard">
        <div t-att-class="cardClass">

            <div class="cm-slot-head">
                <div>
                    <div class="cm-slot-name"><t t-esc="props.round.name"/></div>
                    <div class="cm-slot-window">
                        <i class="fa fa-clock-o me-1"/><t t-esc="props.round.window_label"/>
                    </div>
                </div>
                <span t-att-class="badgeClass"><t t-esc="statusLabel"/></span>
            </div>

            <!-- Whatever the manager wrote on the round: which rooms, what to
                 look out for. It is on the record, so it is shown. -->
            <div t-if="props.round.note" class="cm-slot-note">
                <t t-esc="props.round.note"/>
            </div>

            <!-- Already recorded -->
            <div t-if="props.round.state === 'done'" class="cm-slot-body">
                <div class="cm-slot-line">
                    <i class="fa fa-check-circle text-success me-1"/>
                    Recorded by <strong><t t-esc="props.round.recorded_by"/></strong>
                </div>
                <!-- can_view, not just onView: a round recorded by a colleague
                     is shown as done to everyone, but only its owner and a
                     Manager may read it. Offering the others this button only
                     ever gave them an access error. -->
                <button t-if="props.onView and props.round.can_view"
                        class="btn btn-sm btn-outline-secondary mt-2"
                        t-on-click="() => this.props.onView(props.round)">
                    <i class="fa fa-play me-1"/> Watch
                </button>
            </div>

            <!-- Waiting for the server to confirm the window has opened -->
            <div t-elif="props.pending" class="cm-slot-body">
                <button class="btn btn-secondary btn-lg w-100 mt-2" disabled="disabled">
                    <span class="spinner-border spinner-border-sm me-2" role="status"/>
                    Opening...
                </button>
                <div class="cm-slot-line text-muted mt-1 small">
                    Checking with the server.
                </div>
            </div>

            <!-- Open right now -->
            <div t-elif="props.round.state === 'open'" class="cm-slot-body">
                <div class="cm-slot-line">
                    Closes in <strong><t t-esc="closeCountdown"/></strong>
                </div>
                <button t-if="props.canRecord"
                        class="btn btn-primary btn-lg w-100 mt-2"
                        t-on-click="() => this.props.onRecord(props.round)">
                    <i t-att-class="actionIcon"/><t t-esc="actionLabel"/>
                </button>
                <div t-else="" class="cm-slot-line text-muted mt-2">
                    <i class="fa fa-lock me-1"/>
                    <t t-esc="props.blockedMessage || 'You cannot record this round.'"/>
                </div>
            </div>

            <!-- Still to come -->
            <div t-elif="props.round.state === 'upcoming'" class="cm-slot-body">
                <div class="cm-slot-line">
                    Opens in <strong><t t-esc="openCountdown"/></strong>
                </div>
                <button class="btn btn-secondary btn-lg w-100 mt-2" disabled="disabled">
                    <i t-att-class="actionIcon"/><t t-esc="upcomingLabel"/>
                </button>
            </div>

            <!-- Window passed with nothing recorded -->
            <div t-else="" class="cm-slot-body">
                <div class="cm-slot-line text-danger">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    This round was not recorded.
                </div>
            </div>

        </div>
    </t>

</templates>
