<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Company scoping. Global rules apply to everyone, managers included. -->
        <record id="rule_cleaning_config_company" model="ir.rule">
            <field name="name">Cleaning configuration: own company</field>
            <field name="model_id" ref="model_cleaning_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_slot_company" model="ir.rule">
            <field name="name">Cleaning round: own company</field>
            <field name="model_id" ref="model_cleaning_slot"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_recording_company" model="ir.rule">
            <field name="name">Cleaning recording: own company</field>
            <field name="model_id" ref="model_cleaning_recording"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_slot_missed_company" model="ir.rule">
            <field name="name">Missed cleaning round: own company</field>
            <field name="model_id" ref="model_cleaning_slot_missed"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_reference_image_company" model="ir.rule">
            <field name="name">Original photograph: own company</field>
            <field name="model_id" ref="model_cleaning_reference_image"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cleaning_recording_shot_company" model="ir.rule">
            <field name="name">Round photograph: own company</field>
            <field name="model_id" ref="model_cleaning_recording_shot"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- A User sees their own recordings only. -->
        <record id="rule_cleaning_recording_user_own" model="ir.rule">
            <field name="name">Cleaning recording: own recordings only</field>
            <field name="model_id" ref="model_cleaning_recording"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('showroom_check.group_cleaning_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            A Manager sees everything.

            This record is NOT optional. Manager implies User, so a Manager also
            holds the User group above and would otherwise be quietly narrowed
            to their own recordings - which looks exactly like the module being
            broken. Rules like these are combined with OR across the groups
            somebody holds, so this widens the rule above rather than fighting
            with it.
        -->
        <record id="rule_cleaning_recording_manager_all" model="ir.rule">
            <field name="name">Cleaning recording: manager sees all</field>
            <field name="model_id" ref="model_cleaning_recording"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('showroom_check.group_cleaning_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            The photographs follow their recording exactly.

            Without these two a User could read any colleague's photographs
            straight off /web/image/cleaning.recording.shot/<id>/image: the
            company rule above would let them through, and nothing else would
            stop them. ir.binary checks read access on the record, so these
            rules are what actually enforces it.

            And as above, the manager record is NOT optional - a Manager holds
            the User group too and would otherwise see only their own.
        -->
        <record id="rule_cleaning_shot_user_own" model="ir.rule">
            <field name="name">Round photograph: own rounds only</field>
            <field name="model_id" ref="model_cleaning_recording_shot"/>
            <field name="domain_force">[('recording_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('showroom_check.group_cleaning_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_cleaning_shot_manager_all" model="ir.rule">
            <field name="name">Round photograph: manager sees all</field>
            <field name="model_id" ref="model_cleaning_recording_shot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('showroom_check.group_cleaning_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
