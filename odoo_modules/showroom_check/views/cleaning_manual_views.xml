<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cleaning_manual_list" model="ir.ui.view">
        <field name="name">cleaning.manual.list</field>
        <field name="model">cleaning.manual</field>
        <field name="arch" type="xml">
            <list string="Manuals">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="section"/>
                <!-- A badge rather than plain text: this list is where a mixed
                     shelf is read, and "who is this for" is the column the eye
                     needs to land on. -->
                <field name="audience" widget="badge" optional="show"/>
                <field name="pdf_filename" string="PDF" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <!-- "When was this last replaced" is the first question asked of
                     a library somebody uploads into. -->
                <field name="write_date" string="Last updated" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_cleaning_manual_form" model="ir.ui.view">
        <field name="name">cleaning.manual.form</field>
        <field name="model">cleaning.manual</field>
        <field name="arch" type="xml">
            <form string="Manual">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Write the <b>Guide</b> below and, when you have one, upload the
                        <b>PDF</b>. Help shows a card per document; opening it shows the
                        guide, and the button on the guide opens the full PDF. Only PDF
                        files are accepted.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Recording a round"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Card">
                            <field name="description"
                                   placeholder="What this guide answers, in one line"/>
                            <field name="icon"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Where it appears">
                            <field name="section"/>
                            <!-- The module's manual is one shelf everybody
                                 shares; only app guides are split.

                                 A radio rather than a dropdown: who a document
                                 is for is the decision this form exists to
                                 capture, and both answers should be visible
                                 without opening anything. -->
                            <field name="audience" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="section != 'app'"/>
                        </group>
                    </group>
                    <group string="PDF">
                        <!-- filename= keeps the uploaded name, so the viewer is
                             handed something recognisable rather than "pdf_file". -->
                        <field name="pdf_file" filename="pdf_filename" widget="binary"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="pdf_static_path"
                               placeholder="/showroom_check/static/src/docs/your.pdf (bundled PDFs only)"/>
                    </group>
                    <group string="Guide">
                        <field name="html_content" nolabel="1" widget="html"/>
                        <field name="html_static_path"
                               placeholder="showroom_check/static/src/docs/your.html (bundled guides only)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cleaning_manual_search" model="ir.ui.view">
        <field name="name">cleaning.manual.search</field>
        <field name="model">cleaning.manual</field>
        <field name="arch" type="xml">
            <search string="Manuals">
                <field name="name"/>
                <filter name="filter_app" string="Mobile app"
                        domain="[('section', '=', 'app')]"/>
                <filter name="filter_manual" string="User manual"
                        domain="[('section', '=', 'manual')]"/>
                <separator/>
                <filter name="filter_managers" string="Managers only"
                        domain="[('audience', '=', 'manager')]"/>
                <group>
                    <filter name="group_section" string="Section"
                            context="{'group_by': 'section'}"/>
                    <filter name="group_audience" string="Shown to"
                            context="{'group_by': 'audience'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--
        What Help > User Manual opens: a dialog of cards, one per guide, where
        "Open guide" leaves for the readable page.

        One shelf, not two. The Mobile App entry used the same component until
        its documents started opening straight to the PDF; a card that is a
        title and a download button is a worse list than the list, so that menu
        now opens the documents themselves. The component is still written for
        either shelf - `section` is a param - so pointing a menu back at it is
        one record if the app's guides ever want previewing again.
    -->
    <record id="action_help_guide_module" model="ir.actions.client">
        <field name="name">User Manual</field>
        <field name="tag">showroom_check_help_guide</field>
        <field name="params">{'section': 'manual', 'title': 'User Manual'}</field>
    </record>

    <!--
        Where the documents are uploaded. One action per shelf, so the domain
        keeps the other out of the way and a new document lands on the shelf you
        were already in.

        The app one is Help > Mobile App itself - that shelf is the one people
        upload to.

        The module one is deliberately not on a menu. Its single document ships
        with the code and is seeded once (see the noupdate note in
        cleaning_manual_data.xml), so there is nothing routine to do to it, and a
        menu entry would invite editing documentation that the next release
        replaces anyway. Kept as an action so somebody who genuinely needs it can
        reach it from Settings > Technical > Actions.
    -->
    <record id="action_cleaning_manual_module" model="ir.actions.act_window">
        <field name="name">User Manual</field>
        <field name="res_model">cleaning.manual</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('section', '=', 'manual')]</field>
        <field name="context">{'default_section': 'manual'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the module's manual.</p>
            <p>
                PDFs explaining the module itself — setting up rounds, the
                showroom photographs, who may record. The app lists these under
                Help, as <b>User manual</b>. Set <b>Shown to</b> to Managers to
                keep a document off everyone else's phone.
            </p>
        </field>
    </record>

    <record id="action_cleaning_manual_app" model="ir.actions.act_window">
        <field name="name">Mobile App</field>
        <field name="res_model">cleaning.manual</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('section', '=', 'app')]</field>
        <field name="context">{'default_section': 'app'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload the app's manual.</p>
            <p>
                The manuals for the phone app — recording a round, taking the
                photographs. Upload the <b>PDF</b>: it is what opens when
                somebody picks the document, here and on the phone under
                <b>Profile &gt; Help</b>. A <b>Guide</b> is optional, and is
                shown instead for a document with no PDF yet.
            </p>
            <p>
                <b>Shown to</b> decides who sees it. Leave it on <b>Users</b> for
                the manual everybody gets; set it to <b>Managers</b> for an
                administrator's manual and it stays off everyone else's phone,
                while managers see both.
            </p>
        </field>
    </record>

</odoo>
